# Copy to .env and replace this placeholder with a generated private value.
BREATHDX_JWT_SECRET=REPLACE_WITH_A_GENERATED_SECRET_AT_LEAST_32_CHARACTERS

# Comma-separated web origins; never use a wildcard with private health data.
BREATHDX_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Device access is disabled until BOTH values are configured privately.
BREATHDX_DEVICE_KEY=
BREATHDX_DEVICE_ID=esp32-default
BREATHDX_DEVICE_MEDICAL_ID=

# Opt-in only after verifying a model's provenance; no automatic training.
# Supported selections: disabled, linear_three, linear_single.
BREATHDX_GLUCOSE_MODEL=disabled
BREATHDX_GLUCOSE_MODEL_PATH=
BREATHDX_GLUCOSE_MODEL_SHA256=
# Optional identifier for the unverified TGS acquisition setup; does not enable calibration.
BREATHDX_TGS_PROFILE_ID=
# Step 4: optional reviewed JSON profile, no built-in physical coefficients.
BREATHDX_TGS_CALIBRATION_PATH=
BREATHDX_TGS_MODEL_ENABLED=false
BREATHDX_TGS_MODEL_PATH=
BREATHDX_TGS_MODEL_SHA256=
BREATHDX_TGS_MODEL_VERSION=
# JSON: explicitly chosen max_mae_mg_dl, max_rmse_mg_dl, min_r2; no default acceptance thresholds.
BREATHDX_TGS_EVALUATION_CRITERIA=
# Legacy regression also requires reviewed, hash-bound evaluation metadata.
BREATHDX_GLUCOSE_MODEL_VERSION=
BREATHDX_GLUCOSE_EVALUATION_PATH=
BREATHDX_GLUCOSE_EVALUATION_SHA256=
BREATHDX_GLUCOSE_EVALUATION_CRITERIA=
